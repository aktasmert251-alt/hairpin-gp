# APEX GP multiplayer server (deploy doc section 1.2 step 2). Installed by setup.sh, which replaces __APEX_HOST__.
# Logs: journalctl -u apex      Status: systemctl status apex      Health: curl https://__APEX_HOST__/health
# Admin panel: https://__APEX_HOST__/admin (login created by admin-setup.sh in /opt/apex/data/admin.json)
[Unit]
Description=APEX GP multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apex
Group=apex
WorkingDirectory=/opt/apex
ExecStart=/usr/bin/node /opt/apex/app/apex-server.mjs
# DIST_DIR, CERT_DIR and DATA_DIR default to /opt/apex/dist, /opt/apex/certs and /opt/apex/data (relative to WorkingDirectory).
Environment=NODE_ENV=production PORT=443 HOST=__APEX_HOST__
Restart=always
RestartSec=2
# Give WebSocket clients a moment to get a close frame on restart; the server exits within 3 s itself.
TimeoutStopSec=5

# Bind 443 without root; no other capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/apex/log /opt/apex/certs /opt/apex/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027
# Node's JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off.

# Resource caps
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
